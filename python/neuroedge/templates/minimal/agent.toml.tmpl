# {{name}} — generated by `neuroedge new` (TSK-S3-07).
#
# What the agent needs from a board. `neuroedge build` matches it against the
# board profile before anything reaches hardware, and refuses a board that
# lacks a pin or a capability listed here.
[agent]
name    = "{{name}}"
version = "0.1.0"

[requires]
"digital.out" = { pins = ["door_lock"] }

# Gate key (the `gate=` of an @action) -> gate document.
[gates]
custom_lock = "gates/custom_lock@1.0.0.yaml"

[targets]
supported = ["sim", "linux", "esp32s3"]

# Session facts for `neuroedge run --target sim`. On a device they come from
# your own systems; in the simulator they are set here, and changed in the REPL
# with `:set user_verified false`. They are never inferred from typed text.
[sim.facts]
user_verified = true
