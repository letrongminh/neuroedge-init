# Gate của `{{name}}` (neuroedge add). Đường vào số `{{source}}` (`digital.in`) là một dữ kiện `bool`:
# `[sim.digital_facts]` trong agent.toml nối `{{fact}}` với đường đó. Đường không đọc được, hoặc
# không ai đặt mức, thì tiêu chí không quyết định được và gate chặn (fail-closed), kể cả `fail: open`.
#
#   neuroedge gate explain gates/{{name}}@1.0.0.yaml   # chính sách bằng lời
schema:  neuroedge.gate/v1
name:    {{name}}
version: 1.0.0

arguments:
  duration_s: { type: integer, minimum: 1, maximum: 5 }

evaluate:
  user_verified:
    type: bool
    instructions: "Người dùng đã được xác minh trong phiên hiện tại"
  {{fact}}:
    type: bool
    instructions: "Đường vào số {{source}} đang ở mức cao"

allow_when:
  user_verified: true
  {{fact}}:      true

on_block:
  action:  ask
  message: "Cần xác minh người dùng và tín hiệu {{source}} trước khi {{phrase}}."

budget:
  p95_latency_ms: 150
  fail:           closed
