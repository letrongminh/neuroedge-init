"""
Safety tests for {{name}} (the blinds sample) on the `sim-rpi5` board.

They assert what the servo was told, not what a verdict object says. A hand clock lets a lease run out
and the envelope's interval pass.
"""

import asyncio
from pathlib import Path

import pytest

from neuroedge import SimSession
from neuroedge.actions.tools import ToolCall
from neuroedge.errors import EnvelopeRefusedError

AGENT = Path(__file__).resolve().parents[1] / "agent.toml"


class Clock:
    def __init__(self):
        self.now = 1000.0

    def __call__(self):
        return self.now


def start(*, estop_released=True, current_sense=0.4, path_clear=True):
    """`limit_switch` is the emergency-stop contact (high = released), `adc0` the current-sense volts."""
    clock = Clock()
    session = SimSession.load(AGENT, board_id="sim-rpi5", clock=clock)
    session.set_digital_in("limit_switch", estop_released)
    session.set_analog("adc0", current_sense)
    session.set_fact("path_clear", path_clear)
    return session, clock


def ask(session, tool):
    return asyncio.run(session.call_tool(ToolCall(tool, {}, source="local_grammar"))).content()


def targets(session):
    return [e["target"] for e in session.events.of_type("motion_command")]


def test_the_blinds_open_and_close():
    session, clock = start()
    assert ask(session, "blinds_open")["status"] == "ALLOW"
    clock.now += 2500  # the lease and the hold are over: the servo is off
    session.hal.settle_motion()
    clock.now += 1500  # and the envelope keeps 1 s between two runs
    assert ask(session, "blinds_close")["status"] == "ALLOW"
    assert targets(session) == [90.0, 0.0]
    session.close()


def test_a_lease_nobody_renews_ends_in_the_safe_state():
    session, clock = start()
    ask(session, "blinds_open")
    clock.now += 300
    session.hal.settle_motion()
    safe = list(session.events.of_type("motion_safe"))
    assert [(s["channel"], s["state"], s["cause"]) for s in safe] == [
        ("gripper", "hold", "lease_expired")
    ]
    session.close()


@pytest.mark.parametrize(
    ("setting", "tool", "criterion"),
    [
        ({"estop_released": False}, "blinds_open", "estop_released"),
        ({"current_sense": 0.9}, "blinds_open", "motor_current_sense"),
        ({"path_clear": False}, "blinds_close", "path_clear"),
    ],
)
def test_a_blocked_command_never_moves_the_servo(setting, tool, criterion):
    session, _ = start(**setting)
    answer = ask(session, tool)
    assert answer["status"] == "BLOCK" and answer["failed_criterion"] == criterion
    assert targets(session) == []
    session.close()


def test_the_envelope_refuses_a_second_run_too_soon_even_when_the_gate_allows_it():
    session, clock = start()
    ask(session, "blinds_open")
    clock.now += 2500
    session.hal.settle_motion()  # lease over, hold over: the servo is off
    clock.now += 300
    with pytest.raises(EnvelopeRefusedError):
        ask(session, "blinds_close")
    assert targets(session) == [90.0]
    session.close()
