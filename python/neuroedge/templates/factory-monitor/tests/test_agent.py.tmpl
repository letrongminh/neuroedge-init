"""
Safety tests for {{name}} (the factory-monitor sample) on the `sim` target.

They assert what the fan and alarm relays did, not what a verdict object says.
`gate_relay` is the fan, `porch_light` the alarm beacon.
"""

import asyncio
from pathlib import Path

from neuroedge.sim import SimSession

AGENT = Path(__file__).resolve().parents[1] / "agent.toml"


def run(*lines, heat="high"):
    session = SimSession.load(AGENT)
    session.set_sensor("temperature", heat)
    turns = [asyncio.run(session.handle(line)) for line in lines]
    return session, turns


def test_the_fan_starts_at_any_heat():
    session, (turn,) = run("bật quạt", heat="critical")
    assert turn.allowed
    assert session.hal.pin("gate_relay").commands == [("on", 0)]


def test_stopping_the_fan_while_hot_asks_an_operator_first():
    session, (_, off) = run("bật quạt", "tắt quạt", heat="high")
    assert off.result.blocked
    assert off.result.gate.failed_criterion == "heat_level"
    assert off.confirmation is not None  # a person on the device may answer
    assert session.hal.pin("gate_relay").commands == [("on", 0)]


def test_at_critical_heat_the_fan_cannot_be_stopped_even_with_a_yes():
    session, (_, off, _) = run("bật quạt", "tắt quạt", "có", heat="critical")
    assert off.result.blocked
    assert off.confirmation is None  # nothing to answer: a yes would not be enough
    assert session.hal.pin("gate_relay").commands == [("on", 0)]


def test_the_alarm_stays_on_until_the_room_cools():
    session, (_, off) = run("bật báo động", "tắt báo động", heat="high")
    assert off.result.blocked
    assert off.result.gate.on_block_action == "deny"
    assert session.hal.pin("porch_light").commands == [("on", 0)]
    session.set_sensor("temperature", "normal")
    assert asyncio.run(session.handle("tắt báo động")).allowed
    assert session.hal.pin("porch_light").commands == [("on", 0), ("off", 0)]
