{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.neuroedge.dev/internal/decision_tree/v1.json",
  "title": "NeuroEdge decision tree (internal, not frozen)",
  "$comment": "Internal to the host compiler until RFC-0003 freezes it before the first C walker (TODOS.md #15). Deliberately not in schemas/.",
  "type": "object",
  "required": ["schema", "gate", "gate_digest", "criteria_order", "nodes", "on_block", "budget"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "neuroedge.decision_tree/v1" },
    "gate": { "type": "string", "pattern": "^[a-z0-9_-]+@\\d+\\.\\d+\\.\\d+$" },
    "gate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "criteria_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "kind", "domain", "admitted", "confidence_floor"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string" },
          "kind": { "enum": ["bool", "level", "choice", "numeric"] },
          "domain": { "type": "array", "items": { "type": "string" } },
          "admitted": { "type": "array", "items": { "type": "string" } },
          "confidence_floor": { "type": "number", "minimum": 0, "maximum": 1 },
          "numeric": {
            "type": "object",
            "required": ["unit", "range", "max_age_ms", "lower", "upper"],
            "additionalProperties": false,
            "properties": {
              "unit": { "type": "string" },
              "range": {
                "type": "object",
                "required": ["min", "max"],
                "additionalProperties": false,
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" }
                }
              },
              "max_age_ms": { "type": "integer", "minimum": 1 },
              "lower": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["value", "closed"],
                    "additionalProperties": false,
                    "properties": {
                      "value": { "type": "number" },
                      "closed": { "type": "boolean" }
                    }
                  }
                ]
              },
              "upper": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["value", "closed"],
                    "additionalProperties": false,
                    "properties": {
                      "value": { "type": "number" },
                      "closed": { "type": "boolean" }
                    }
                  }
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "numeric" } } },
            "then": {
              "required": ["numeric"],
              "properties": {
                "domain": { "maxItems": 0 },
                "admitted": { "maxItems": 0 }
              }
            },
            "else": {
              "not": { "required": ["numeric"] },
              "properties": {
                "domain": { "minItems": 1 }
              }
            }
          }
        ]
      }
    },
    "arguments": {
      "$comment": "RFC-0005 argument limits, checked before the nodes; absent when the gate declares none.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["string", "integer", "number", "boolean"] },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "enum": { "type": "array", "minItems": 1 },
          "max_length": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "on_block": { "type": "object", "required": ["action"] },
    "budget": {
      "type": "object",
      "required": ["p95_latency_ms", "fail"],
      "properties": {
        "p95_latency_ms": { "type": "integer", "minimum": 1 },
        "fail": { "enum": ["closed", "open"] }
      }
    }
  }
}
