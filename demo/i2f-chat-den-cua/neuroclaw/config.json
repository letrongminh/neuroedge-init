{
  "version": 3,
  "agents": {
    "defaults": {
      "workspace": "~/.picoclaw/workspace",
      "restrict_to_workspace": true,
      "model_name": "nao",
      "max_tokens": 4096,
      "max_tool_iterations": 10
    }
  },
  "model_list": [
    {
      "model_name": "nao",
      "provider": "openrouter",
      "model": "anthropic/claude-haiku-4.5"
    }
  ],
  "channel_list": {
    "telegram": {
      "enabled": true,
      "type": "telegram",
      "allow_from": [
        "ID_TELEGRAM_CUA_CHU_NHA"
      ],
      "settings": {
        "streaming": {
          "enabled": false
        }
      }
    }
  },
  "tools": {
    "allow_read_paths": [],
    "allow_write_paths": [],
    "web": {
      "enabled": true,
      "provider": "auto",
      "duckduckgo": {
        "enabled": true,
        "max_results": 5
      }
    },
    "cron": {
      "enabled": true,
      "allow_command": false
    },
    "exec": {
      "enabled": false
    },
    "i2c": {
      "enabled": false
    },
    "spi": {
      "enabled": false
    },
    "serial": {
      "enabled": false
    },
    "install_skill": {
      "enabled": false
    },
    "skills": {
      "enabled": true,
      "registries": {
        "clawhub": {
          "enabled": false
        },
        "github": {
          "enabled": false
        }
      }
    },
    "find_skills": {
      "enabled": false
    },
    "mcp": {
      "enabled": true,
      "discovery": {
        "enabled": false
      },
      "servers": {
        "neuroedge": {
          "enabled": true,
          "type": "http",
          "url": "https://DIA_CHI_HOP:8443/mcp",
          "headers": {
            "Authorization": "Bearer NOI_DUNG_NAO_TOKEN"
          },
          "tls": {
            "ca_file": "KHOA/ca.pem",
            "cert_file": "KHOA/nao.pem",
            "key_file": "KHOA/nao.key",
            "server_name": "localhost"
          }
        }
      }
    },
    "read_file": {
      "enabled": true,
      "mode": "bytes"
    },
    "write_file": {
      "enabled": true
    },
    "edit_file": {
      "enabled": true
    },
    "append_file": {
      "enabled": true
    },
    "list_dir": {
      "enabled": true
    },
    "message": {
      "enabled": true
    },
    "web_fetch": {
      "enabled": true
    },
    "spawn": {
      "enabled": true
    },
    "spawn_status": {
      "enabled": true
    },
    "subagent": {
      "enabled": true
    },
    "send_file": {
      "enabled": false
    },
    "send_tts": {
      "enabled": false
    },
    "load_image": {
      "enabled": false
    }
  },
  "heartbeat": {
    "enabled": true,
    "interval": 30
  },
  "devices": {
    "enabled": false,
    "monitor_usb": false
  },
  "hooks": {
    "enabled": false
  },
  "evolution": {
    "enabled": false
  },
  "events": {
    "logging": {
      "enabled": true,
      "include": [
        "agent.*"
      ],
      "min_severity": "info",
      "include_payload": false
    }
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790,
    "log_level": "info"
  }
}
